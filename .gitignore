# ---------------------------------------------------------------
# Wintaskly — fichiers exclus du dépôt
#
# Trois familles :
#   1. secrets et configuration propres à une installation
#   2. données produites à l'exécution (cache, logs, téléversements)
#   3. outillage local (Node, éditeurs, archives de déploiement)
#
# Règle de tri : si le fichier est recréé automatiquement, ou s'il
# diffère entre le poste local et la production, il est exclu.
# ---------------------------------------------------------------

# --- 1. Configuration et secrets --------------------------------
config.php
.installed.lock

# --- 2. Données produites à l'exécution -------------------------
includes/ad_tags_rules.json
includes/rates_cache.json
logs/*
!logs/.gitkeep
*.log
media/wintaskly/img/banners/*
!media/wintaskly/img/banners/.gitkeep
/*-verification*.html
/*_verification*.txt
/google*.html

# --- 3. Outillage local -----------------------------------------
node_modules/
deploy_wintaskly.bat
*.zip
*.tar.gz
*.bak
*.orig
*.tmp
*~
sql/dump*.sql
sql/backup*.sql
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Note sur Tailwind ------------------------------------------
# media/wintaskly/css/tailwind.css est VOLONTAIREMENT versionné.
