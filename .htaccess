# =====================================================================
# Wintaskly — .htaccess pour LWS mutualisé (version minimale safe)
# =====================================================================
# Les directives <Directory>, Options -Indexes, php_flag, AddOutputFilter
# sont souvent BLOQUÉES sur LWS mutualisé (AllowOverride restreint).
# Si elles sont présentes → HTTP 500 immédiat. On garde donc le minimum
# qui marche partout : DirectoryIndex, mod_rewrite, ErrorDocument, Headers.

# --------------------------------------------------------------------
# DirectoryIndex : force notre index.php EN PREMIER
# --------------------------------------------------------------------
# Sur LWS, sans ça, Apache sert le default_index.php LWS qui affiche
# "ERROR 500" avec le logo LWS quand notre site n'est pas trouvé.
DirectoryIndex index.php index.html

# --------------------------------------------------------------------
# Pages d'erreur custom (remplacent l'écran orange LWS)
# --------------------------------------------------------------------
ErrorDocument 404 /error-404.html
ErrorDocument 500 /error-500.html
ErrorDocument 502 /error-500.html
ErrorDocument 503 /error-500.html

# --------------------------------------------------------------------
# Réécriture URL (mod_rewrite)
# --------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Bloque l'accès direct aux dossiers sensibles
  RewriteRule ^(includes|sql|node_modules|frontend|logs)(/|$) - [F,L]

  # Bloque les fichiers internes du dossier /install/ (préfixe _)
  RewriteRule ^install/_ - [F,L]

  # Empêche d'exposer config.php et ses variantes
  RewriteRule ^config(\.[a-z]+)?\.php$ - [F,L]

  # Bloque les fichiers de backup / temp / éditeur résiduels
  RewriteRule ^.+\.(bak|swp|orig|tmp|old|~)$ - [F,L]

  # Pretty URL : /help/contact-track/<token> → script central
  RewriteRule ^help/contact-track/([a-f0-9]{32,64})/?$ help/contact-track/index.php?token=$1 [QSA,L]

  # Pretty URLs du blog
  #   /blog                          → liste
  #   /blog/categorie/<slug>         → liste filtrée par catégorie
  #   /blog/<slug>                   → article
  # Sitemap dynamique (declare dans robots.txt)
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  RewriteRule ^blog/?$ blog/index.php [QSA,L]
  RewriteRule ^blog/categorie/([a-z0-9-]+)/?$ blog/index.php?cat=$1 [QSA,L]
  RewriteRule ^blog/([a-z0-9-]+)/?$ blog/post.php?slug=$1 [QSA,L]

  # Pretty URLs des campagnes d'acquisition
  #   /campagn                       → page seule, aucune campagne
  #   /campagn/<annee>               → page + annee, sans code
  #   /campagn/<annee>/<code>        → page + campagne identifiee
  #
  # L'annee et le code ne sont que des PARAMETRES : aucune page n'est a
  # creer d'une annee sur l'autre. Une valeur inconnue affiche la page
  # normalement, sans recompense — un lien perime qui circule encore sur
  # un site partenaire ne doit pas produire une erreur 404, sinon on perd
  # le visiteur au lieu de le convertir.
  RewriteRule ^campagn/?$ campagn/index.php [QSA,L]
  RewriteRule ^campagn/([0-9]{4})/?$ campagn/index.php?y=$1 [QSA,L]
  RewriteRule ^campagn/([0-9]{4})/([A-Za-z0-9]{1,24})/?$ campagn/index.php?y=$1&c=$2 [QSA,L]
</IfModule>

# --------------------------------------------------------------------
# Sécurité de base — refuse l'accès aux fichiers sensibles
# --------------------------------------------------------------------
<FilesMatch "(^\.|\.(env|git|sql|md|json|lock|log)$)">
  Require all denied
</FilesMatch>

# --------------------------------------------------------------------
# Headers de sécurité (optionnel : encadré dans IfModule pour safe)
# --------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --------------------------------------------------------------------
# PWA — Manifest MIME type
# --------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

# Service Worker : pas de cache + scope max /
<IfModule mod_headers.c>
  <Files "sw.js">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Service-Worker-Allowed "/"
  </Files>
</IfModule>

# =====================================================================
# PERFORMANCE & SÉCURITÉ — ajouté en 8.38.0
# =====================================================================
# ⚠️ LWS MUTUALISÉ : ces blocs sont volontairement SÉPARÉS et encadrés
# par <IfModule>. Si le site renvoie une erreur 500 après ajout, retire
# UN SEUL bloc à la fois pour identifier celui qui n'est pas autorisé
# (AllowOverride restreint) — les autres continueront de fonctionner.
# Ordre de dépannage conseillé : COMPRESSION, puis CACHE, puis HSTS.
# =====================================================================

# --------------------------------------------------------------------
# 1) COMPRESSION — gain mesuré : 560 Ko -> 104 Ko (-81 %)
# --------------------------------------------------------------------
# N'inclut PAS les images : PNG/JPG/WebP sont déjà compressés, les
# recompresser consomme du CPU sans réduire la taille.
<IfModule mod_deflate.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE text/javascript application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript application/json
    AddOutputFilterByType DEFLATE application/xml application/rss+xml
    AddOutputFilterByType DEFLATE application/manifest+json
    AddOutputFilterByType DEFLATE image/svg+xml
  </IfModule>
</IfModule>

# --------------------------------------------------------------------
# 2) CACHE NAVIGATEUR sur les fichiers statiques
# --------------------------------------------------------------------
# Sans risque de servir une version périmée : les CSS/JS sont appelés
# avec ?v=<WT_VERSION>, donc chaque mise à jour change l'URL et force
# le rechargement. Les pages PHP restent en no-store (défini dans
# includes/init.php) — seules les ressources statiques sont mises en cache.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType text/javascript           "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/png                 "access plus 6 months"
  ExpiresByType image/jpeg                "access plus 6 months"
  ExpiresByType image/gif                 "access plus 6 months"
  ExpiresByType image/webp                "access plus 6 months"
  ExpiresByType image/svg+xml             "access plus 6 months"
  ExpiresByType image/x-icon              "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType application/font-woff2    "access plus 1 year"
</IfModule>

# immutable : indique au navigateur de ne même pas revalider tant que
# l'URL (donc la version) ne change pas.
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2?|png|jpe?g|gif|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# --------------------------------------------------------------------
# 3) EN-TÊTES DE SÉCURITÉ COMPLÉMENTAIRES
# --------------------------------------------------------------------
<IfModule mod_headers.c>
  # HSTS — uniquement servi en HTTPS (env=HTTPS), sinon sans effet.
  # ⚠️ Engagement fort : une fois cette en-tête reçue, le navigateur
  # REFUSERA le HTTP sur le domaine pendant 1 an. À n'activer que si le
  # certificat HTTPS est en place et le restera.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS

  # Masque la version exacte de PHP (indice précieux pour un attaquant)
  Header unset X-Powered-By
</IfModule>
